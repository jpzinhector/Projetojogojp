{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Compilar Raylib",
            "command": "C:/raylib/w64devkit/bin/gcc.exe",
            "args": [
                "${workspaceFolder}/ProjetoJogo/Codigo/main.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/arena.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/player.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/inimigo.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/arma.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/lista_inimigos.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/fila_ondas.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/ondas.c",
                "${workspaceFolder}/ProjetoJogo/Codigo/ui.c",
                "-o",
                "${workspaceFolder}/ProjetoJogo/Codigo/jogo.exe",
                "-m64",
                "-O1",
                "-Wall",
                "-std=c99",
                "-Wno-missing-braces",
                "-I", "C:/raylib/raylib/src",
                "-L", "C:/raylib/raylib/src",
                "-lraylib",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm"
            ],
            "options": {
                "env": {
                    "PATH": "C:/raylib/w64devkit/bin;${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}